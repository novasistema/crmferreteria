# Variables por cliente (Vercel → Settings → Environment Variables)

# Obligatoria para facturar con ARCA: frase secreta larga (mínimo 16 caracteres).
# Cifra la clave privada del certificado. No la cambies después de configurar ARCA.
ARCA_SECRET=

# Opcionales: base Firebase propia del cliente (si no se cargan, usa la base de demo)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=
