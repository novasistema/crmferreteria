# ---------------------------------------------------------------------------
# MODO DEMO
# true  = demo pública: login con 1 clic, claves visibles, datos de ejemplo.
# (vacío o cualquier otro valor) = PRODUCCIÓN: login real, sin claves comodín.
# Poner en true SOLO en el proyecto de Vercel de la demostración.
# ---------------------------------------------------------------------------
VITE_MODO_DEMO=

# ---------------------------------------------------------------------------
# FIREBASE DEL CLIENTE (Firebase Console → Configuración del proyecto → Tus apps → Web)
# Si no se completan, se usa firebase-applet-config.json (proyecto original de AI Studio).
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Dejar vacío para usar la base "(default)" del proyecto
VITE_FIREBASE_DATABASE_ID=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
