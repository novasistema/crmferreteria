rules_version = '2';

// ============================================================================
// REGLAS DEL DEPLOY DE DEMOSTRACIÓN (VITE_MODO_DEMO=true)
//
// La demo usa inicio de sesión anónimo de Firebase, así que cualquiera que abra
// la página puede leer y modificar los datos de ejemplo. NUNCA usar estas reglas
// en el proyecto de Firebase de un cliente: para eso está firestore.rules.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
